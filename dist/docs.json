          "type": "string[] | undefined"
        },
        {
          "name": "exposeHeaders",
          "tags": [],
          "docs": "",
          "complexTypes": [],
          "type": "string[] | undefined"
        },
        {
          "name": "allowCredentials",
          "tags": [],
          "docs": "Sends `Access-Control-Allow-Credentials: true` and, when `origins` is\nleft at the default `['*']`, reflects the request's `Origin` back\nverbatim instead of sending a literal `*` (required by browsers for\ncredentialed requests). See the `origins` documentation above -\npair this with an explicit `origins` allowlist, otherwise any site can\nmake credentialed requests against this server.",
          "complexTypes": [],
          "type": "boolean | undefined"
        },
