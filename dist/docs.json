      "properties": [
        {
          "name": "host",
          "tags": [],
          "docs": "Interface to bind. Use `127.0.0.1` for local-only access or `0.0.0.0`\nwhen other devices on the LAN should be able to connect.",
          "complexTypes": [],
          "type": "string | undefined"
        },
        {
          "name": "port",
          "tags": [],
          "docs": "TCP port to listen on. Pass `0` to let the platform pick a free port and\nread the selected value from `ServerInfo.port`. The web mock reports `0`\nbecause it does not open a socket.",
          "complexTypes": [],
          "type": "number"
        },
        {
          "name": "cors",
          "tags": [],
          "docs": "",
          "complexTypes": [
