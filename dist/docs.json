        },
        {
          "name": "auth",
          "tags": [],
          "docs": "",
          "complexTypes": [
            "AuthOptions"
          ],
          "type": "AuthOptions"
        },
        {
          "name": "maxBodySizeBytes",
          "tags": [],
          "docs": "Maximum accepted request body size in bytes. Requests over the limit return\n`413 Payload Too Large` before they reach the JavaScript handler.\n\nDefaults to 10 MiB.",
          "complexTypes": [],
          "type": "number | undefined"
        },
        {
          "name": "requestTimeoutMs",
          "tags": [],
          "docs": "Maximum time a synchronous route waits for `respond()`.\nIf the JavaScript handler settles after this window, the HTTP client has\nalready received `504 Gateway Timeout` and the late response is ignored.\n\nDefaults to 30 seconds.",
          "complexTypes": [],
          "type": "number | undefined"
        },
        {
          "name": "jobRetentionMs",
          "tags": [],
          "docs": "Time an unfinished async job remains readable from `/__jobs/:jobId`.\n\nDefaults to 5 minutes.",
          "complexTypes": [],
          "type": "number | undefined"
        },
        {
          "name": "maxRetainedJobs",
          "tags": [],
          "docs": "Maximum number of retained jobs (any status). Completed, failed,\ncancelled, and expired jobs are not deleted automatically otherwise, so\nwithout this cap a client that never calls `deleteJob()`/\n`DELETE /__jobs/:jobId` would let retained jobs (including their\noriginal request bodies) grow without bound. Once the cap is exceeded,\nthe oldest jobs in a terminal state (`completed`, `failed`, `cancelled`,\n`expired`) are evicted first; jobs still `queued`/`running` are never\nevicted by this cap.\n\nDefaults to 1000.",
          "complexTypes": [],
          "type": "number | undefined"
        }
      ]
    },
    {
      "name": "CorsOptions",
      "slug": "corsoptions",
      "docs": "",
